        "line": 1309,
        "text": "    for cycle in range(max_cycle):"
      },
      {
        "line": 1310,
        "text": "        axt = aop(x1)"
      },
      {
        "line": 1311,
        "text": "        if axt.ndim == 1:"
      },
      {
        "line": 1312,
        "text": "            axt = axt.reshape(1,ndim)"
      },
      {
        "line": 1313,
        "text": "        xs.extend(x1)"
      },
      {
        "line": 1314,
        "text": "        ax.extend(axt)"
      },
      {
        "line": 1315,
        "text": "        if callable(callback):"
      },
      {
        "line": 1316,
        "text": "            callback(cycle, xs, ax)"
      },
      {
        "line": 1317,
        "text": ""
      },
      {
        "line": 1318,
        "text": "        x1 = axt.copy()"
      },
      {
        "line": 1319,
        "text": "        for i in range(len(xs)):"
      },
      {
        "line": 1320,
        "text": "            xsi = numpy.asarray(xs[i])"
      },
      {
        "line": 1321,
        "text": "            w = dot(axt, xsi.conj()) / innerprod[i]"
      },
      {
        "line": 1322,
        "text": "            x1 -= xsi * w[:,None]"
      },
      {
        "line": 1323,
        "text": "        axt = None"
      },
      {
        "line": 1324,
        "text": ""
      },
      {
        "line": 1325,
        "text": "        if nroots > 1:"
      },
      {
        "line": 1326,
        "text": "            x1, rmat = _qr(x1, dot)"
      },
      {
        "line": 1327,
        "text": "            x1 *= rmat.diagonal()[:,None]"
      },
      {
        "line": 1328,
        "text": "            innerprod1 = rmat.diagonal().real ** 2"
      },
      {
        "line": 1329,
        "text": "        else:"
      },
      {
        "line": 1330,
        "text": "            innerprod1 = [dot(x1[0].conj(), x1[0]).real]"
      },
      {
        "line": 1331,
        "text": "        max_innerprod = max(innerprod1, default=0.)"
      },
      {
        "line": 1332,
        "text": ""
      },
      {
        "line": 1333,
        "text": "        log.debug('krylov cycle %d  r = %g', cycle, max_innerprod**.5)"
      },
      {
        "line": 1334,
        "text": "        if max_innerprod < lindep or max_innerprod < tol**2:"
      },
      {
        "line": 1335,
        "text": "            break"
      },
      {
        "line": 1336,
        "text": ""
      },
      {
        "line": 1337,
        "text": "        if nroots > 1:"
      },
      {
        "line": 1338,
        "text": "            mask = (innerprod1 > lindep) & (innerprod1 > tol**2)"
      },
      {
        "line": 1339,
        "text": "            x1 = x1[mask]"
      },
      {
        "line": 1340,
        "text": "            innerprod.extend(innerprod1[mask])"
      },
      {
        "line": 1341,
        "text": "        else:"
      },
      {
        "line": 1342,
        "text": "            innerprod.append(innerprod1[0])"
      },
      {
        "line": 1343,
        "text": ""
      },
      {
        "line": 1344,
        "text": "    else:"
      },
      {
        "line": 1345,
        "text": "        raise RuntimeError(\"Krylov solver failed to converge.\")"
      }
    ]
