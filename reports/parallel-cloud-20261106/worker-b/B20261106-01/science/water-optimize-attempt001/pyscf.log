"""Portable, separately supervised B water/compound Opt/Freq worker.

Default operation is NOT_RUN. Every actual operation, including force-field
preparation and NumPy analysis, requires the B supervisor's live resource proof.
There is no dependency on A's ledger, boot, checkpoints, ignored caches or sites.
"""
from __future__ import annotations

import argparse
from collections import Counter
import csv
from datetime import datetime, timezone
import hashlib
import importlib.metadata
import importlib.util
import json
import math
import os
from pathlib import Path
import resource
import signal
import sys
import time
import traceback

ROOT = Path(__file__).resolve().parents[1]
INPUT = ROOT / 'data/research/parallel_cloud_20261106/worker_b/cases.json'
INPUT_SHA = '84f306a6e09a6b162650988d8ba81a34529f58a21accd53626d87e923613d893'
SUPERVISOR = ROOT / 'scripts/research4_parallel_b_supervisor_20261106.py'
SCHEMA = 'research4-parallel-b-quantum-result-v1'
CASE_NAMES = ('water', 'protocatechuic_acid', 'calycosin')
OPERATIONS = ('prepare', 'optimize', 'frequency', 'analyze')
CM1_TO_THZ = .0299792458
BOHR_TO_ANGSTROM = .52917721092
FREQUENCY_FACTOR_CM1 = 5140.487138493369
MASSES = {'H': 1.008, 'C': 12.011, 'O': 15.999}


def require(ok, message):
    if not ok:
        raise ValueError(message)


def utc():
    return datetime.now(timezone.utc).isoformat()


def sha(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda: stream.read(1024 ** 2), b''):
            digest.update(block)
    return digest.hexdigest()


def artifact(path):
    path = Path(path).resolve()
    require(path.is_relative_to(ROOT), 'Portable report artifacts must remain inside this checkout')
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(path), 'bytes': path.stat().st_size}


def read_json(path, expected=None):
    path = Path(path)
    require(not path.is_symlink() and path.is_file() and path.stat().st_size <= 2 * 1024 ** 2,
            'Small explicit non-symlink JSON required')
    if expected:
        require(sha(path) == expected, 'Metadata source hash differs: ' + str(path))
    return json.loads(path.read_text())


def save(path, value, exclusive=False):
    path = Path(path)
    temporary = path if exclusive else path.with_suffix(path.suffix + '.writing')
    with temporary.open('x') as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False, allow_nan=False)
        stream.write('\n'); stream.flush(); os.fsync(stream.fileno())
    if not exclusive:
        os.replace(temporary, path)


def checked_record(record, parent=None):
    require(isinstance(record, dict) and 'path' in record and 'sha256' in record, 'Artifact path/hash required')
    path = Path(record['path'])
    if not path.is_absolute():
        path = (Path(parent) if parent is not None else ROOT) / path
    require(path.is_file() and not path.is_symlink() and sha(path) == record['sha256'], 'Changed artifact: ' + str(path))
    if 'bytes' in record:
        require(path.stat().st_size == record['bytes'], 'Changed artifact size')
    return path.resolve()


def input_case(name):
    require(name in CASE_NAMES, 'Only the three explicitly registered B cases are allowed')
    manifest = read_json(INPUT, INPUT_SHA)
    require(manifest['schema'] == 'research4-parallel-b-chemical-cases-v1', 'Wrong case input schema')
    checked_record(manifest['source_evidence'], INPUT.parent)
    case = manifest['cases'][name]
    require(case['charge'] == case['spin_2S'] == 0 and case['multiplicity'] == 1,
            'Only verified neutral singlets are supported')
    require(case['expected_normal_modes'] == 3 * case['atoms'] - 6, 'Expected nonlinear mode count differs')
    if 'supplied_sdf' in case:
        checked_record(case['supplied_sdf'], INPUT.parent)
    return manifest, case


def supervise(args):
    require(args.threads in (1, 2) and 1 <= args.maxsteps <= 35, 'Bounded1/2threads and1..35steps required')
    spec = importlib.util.spec_from_file_location('research4_b_live_supervision', SUPERVISOR)
    require(spec is not None and spec.loader is not None, 'Portable B supervisor missing')
    module = importlib.util.module_from_spec(spec); sys.modules[spec.name] = module; spec.loader.exec_module(module)
    return module.verify_b_resource_supervision(expected_threads=args.threads,
        expected_worker_path=Path(__file__).resolve(), expected_case=args.case,
        expected_input_manifest_sha256=INPUT_SHA, expected_operation=args.operation)


def new_output(path):
    path = Path(path)
    require(not path.exists() and not path.is_symlink()
            and path.resolve().is_relative_to(ROOT / 'reports'), 'Fresh independent attempt directory inside ROOT/reports required')
    path.mkdir(parents=True)
    return path.resolve()


def versions():
    return {name: importlib.metadata.version(name)
            for name in ('pyscf', 'geometric', 'numpy', 'scipy', 'rdkit')}


def xyz_text(symbols, coordinates, comment):
    return str(len(symbols)) + '\n' + comment + '\n' + ''.join(
        f'{symbol} {float(c[0]):.15f} {float(c[1]):.15f} {float(c[2]):.15f}\n'
        for symbol, c in zip(symbols, coordinates))


def validate_coordinates(symbols, coordinates, case):
    require(Counter(symbols) == case['composition'] and len(symbols) == len(coordinates) == case['atoms'],
            'Full atom composition/shape differs')
    require(all(len(c) == 3 and all(math.isfinite(float(v)) for v in c) for c in coordinates),
            'Nonfinite or incomplete coordinates')


def save_array(path, value, np):
    require(not Path(path).exists() and np.isfinite(value).all(), 'Fresh finite array required')
    with Path(path).open('xb') as stream:
        np.save(stream, value, allow_pickle=False)


def source_result(args, expected_operation, expected_status):
    require(args.source_result is not None and args.source_result_sha256, 'Actual preceding result path/hash required')
    source = read_json(args.source_result, args.source_result_sha256)
    require(source.get('schema') == SCHEMA and source.get('case') == args.case
            and source.get('input_manifest_sha256') == INPUT_SHA
            and source.get('operation') == expected_operation and source.get('status') in expected_status,
            'Preceding case/operation/result status differs')
    require(source.get('source_worker', {}).get('sha256') == sha(__file__), 'Preceding computation source differs')
    require(source.get('settings') == input_case(args.case)[0]['method'], 'Preceding physical method differs')
    return source


def prepared_geometry(args, case):
    source = source_result(args, 'prepare', ('PREPARED_FORCE_FIELD_MODELS',))
    selected = read_json(checked_record(source['selected_conformer']))
    require(selected.get('force_field_converged') is True, 'Selected force-field geometry is unconverged')
    symbols, coords = selected['atom_symbols'], selected['coordinates_angstrom']
    validate_coordinates(symbols, coords, case)
    return source, symbols, coords


def optimized_geometry(args, case):
    source = source_result(args, 'optimize', ('OPTIMIZATION_CONVERGED',))
    require(source.get('optimizer_converged') is True and source.get('scf_converged') is True
            and source.get('fresh_gradient_thresholds_passed') is True, 'A true fresh-gradient-qualified optimization is required')
    selected = read_json(checked_record(source['optimized_geometry']))
    symbols, coords = selected['atom_symbols'], selected['coordinates_angstrom']
    validate_coordinates(symbols, coords, case)
    return source, symbols, coords


def prepare(args, state, output, case, emit):
    from rdkit import Chem
    from rdkit.Chem import AllChem, rdMolDescriptors
    graph = Chem.MolFromSmiles(case['smiles'])
    require(graph is not None and Chem.MolToInchiKey(graph) == case['full_inchikey'], 'Source graph identity mismatch')
    mol = Chem.AddHs(graph)
    require(Chem.GetFormalCharge(mol) == case['charge']
            and sum(a.GetNumRadicalElectrons() for a in mol.GetAtoms()) == 0
            and rdMolDescriptors.CalcMolFormula(mol) == case['formula']
            and Counter(a.GetSymbol() for a in mol.GetAtoms()) == case['composition'], 'Actual neutral formula/radicals differ')
    require(not Chem.FindMolChiralCenters(graph, includeUnassigned=True), 'Unexpected defined/unresolved stereo for these achiral cases')
    if 'supplied_sdf' in case:
        supplier = Chem.SDMolSupplier(str(checked_record(case['supplied_sdf'], INPUT.parent)), removeHs=False)
        records = [record for record in supplier if record is not None]
        require(len(records) == 1 and Chem.MolToInchiKey(records[0]) == case['full_inchikey']
                and rdMolDescriptors.CalcMolFormula(records[0]) == case['formula'], 'Supplied SDF graph/formula differs')
        state['supplied_SDF_graph_verified'] = True
        state['supplied_SDF_coordinates_used'] = False
    params = AllChem.ETKDGv3(); params.randomSeed = args.seed; params.numThreads = 1; params.pruneRmsThresh = .1
    ids = list(AllChem.EmbedMultipleConfs(mol, numConfs=args.conformers, params=params))
    require(ids, 'No actual ETKDG conformer generated')
    mmff = bool(AllChem.MMFFHasAllMoleculeParams(mol))
    require(mmff or args.case == 'water', 'MMFF94s parameters missing for registered compound')
    properties = AllChem.MMFFGetMoleculeProperties(mol, mmffVariant='MMFF94s') if mmff else None
    force_field = 'MMFF94s' if mmff else 'UFF_EXPLICIT_WATER_ONLY_FALLBACK'
    records = []; symbols = [a.GetSymbol() for a in mol.GetAtoms()]
    for cid in ids:
        field = AllChem.MMFFGetMoleculeForceField(mol, properties, confId=cid) if mmff else AllChem.UFFGetMoleculeForceField(mol, confId=cid)
        require(field is not None, 'Force field not available')
        status = int(field.Minimize(maxIts=500)); energy = float(field.CalcEnergy())
        coords = [[float(v) for v in row] for row in mol.GetConformer(cid).GetPositions()]
        validate_coordinates(symbols, coords, case)
        value = {'atom_symbols': symbols, 'coordinates_angstrom': coords, 'conformer_id': cid,
                 'force_field': force_field, 'force_field_status': status, 'force_field_converged': status == 0,
                 'force_field_energy_kcal_mol': energy, 'DFT_status': 'NOT_RUN', 'experimental_crystal_coordinates': False}
        path = output / f'conformer_{cid:03d}.json'; save(path, value, exclusive=True)
        (output / f'conformer_{cid:03d}.xyz').write_text(xyz_text(symbols, coords, 'ETKDG/force-field model, not DFT or experimental3D'))
        records.append({**value, 'artifact': artifact(path)})
    converged = [r for r in records if r['force_field_converged'] and math.isfinite(r['force_field_energy_kcal_mol'])]
    require(converged, 'No force-field-converged candidate')
    chosen = min(converged, key=lambda r: (r['force_field_energy_kcal_mol'], r['conformer_id']))
    state.update(status='PREPARED_FORCE_FIELD_MODELS', selected_conformer=chosen['artifact'], conformers=records,
                 requested_conformers=args.conformers, actual_embedded_conformers=len(ids), seed=args.seed,
                 force_field=force_field, global_minimum_claim=False, numerical_DFT_operations=0)
    emit('force_field_preparation_complete', selected_conformer_id=chosen['conformer_id'], actual_embedded_conformers=len(ids))


def make_scf(mol, settings, checkpoint, threads, emit):
    from pyscf import dft, lib
    from pyscf.scf import hf
    class ScreenedDirectRKS(dft.rks.RKS):
        def get_jk(self, mol=None, dm=None, hermi=1, with_j=True, with_k=True, omega=None):
            require(self._eri is None and self.direct_scf is True and self.mol.incore_anyway is False,
                    'Full screened-direct policy violated')
            return hf.SCF.get_jk(self, mol=mol, dm=dm, hermi=hermi, with_j=with_j, with_k=with_k, omega=omega)
    lib.num_threads(threads)
    mf = ScreenedDirectRKS(mol); mf.xc = settings['xc']; mf.disp = None
    mf.max_memory = settings['max_memory_mb']; mf.direct_scf = True; mf.direct_scf_tol = settings['direct_scf_tol']
    mf.conv_tol = settings['scf_conv_tol']; mf.max_cycle = settings['scf_max_cycle']
    mf.conv_tol_cpscf = settings['CPHF_conv_tol']; mf.grids.level = settings['grid_level']; mf.chkfile = str(checkpoint)
    mf._eri = None; mf.mol.incore_anyway = False
    mf.callback = lambda env: emit('scf_cycle', cycle=int(env.get('cycle', -1)), energy_hartree=float(env['e_tot']))
    return mf


def gradient_of(mf, settings, emit):
    require(mf.converged, 'Unconverged SCF cannot enter gradient')
    value = mf.nuc_grad_method(); value.grid_response = settings['gradient_grid_response']
    emit('gradient_started')
    result = value.kernel()
    emit('gradient_complete')
    return result


def gradient_checks(np, gradient, settings):
    require(gradient.ndim == 2 and gradient.shape[1] == 3 and np.isfinite(gradient).all(), 'Full finite gradient required')
    norms = np.linalg.norm(gradient, axis=1)
    rms = float(np.sqrt(np.mean(norms ** 2))); maximum = float(np.max(norms))
    passed = rms <= settings['optimizer_thresholds']['convergence_grms'] and maximum <= settings['optimizer_thresholds']['convergence_gmax']
    return {'atom_gradient_rms_hartree_per_bohr': rms, 'atom_gradient_max_hartree_per_bohr': maximum,
            'fresh_gradient_thresholds_passed': bool(passed), 'final_gradient_thresholds_passed': bool(passed)}


def signed_mode_flags(frequencies, expected, fresh_gradient_passed):
    values = [float(v) for v in frequencies]
    require(len(values) == expected and all(math.isfinite(v) for v in values), 'All finite signed modes required')
    positive = all(v > 0 for v in values)
    return {'normal_mode_count': len(values), 'imaginary_frequency_count': sum(v < 0 for v in values),
            'positive_frequency_count': sum(v > 0 for v in values), 'zero_frequency_count': sum(v == 0 for v in values),
            'all_frequencies_real_positive': positive,
            'stationary_minimum_verified': bool(positive and fresh_gradient_passed),
            'frequency_validation_passed': bool(positive and fresh_gradient_passed)}


def molecule(case, symbols, coords, settings, log):
    from pyscf import gto
    mol = gto.Mole(); mol.stdout = log
    mol.build(atom=list(zip(symbols, coords)), unit='Angstrom', basis=settings['basis'], charge=case['charge'],
              spin=case['spin_2S'], symmetry=False, max_memory=settings['max_memory_mb'], verbose=4)
    mol.incore_anyway = False
    require(mol.natm == case['atoms'] and mol.nelectron == case['electrons'] and mol.nao_nr() == case['basis_functions'],
            'Actual full AO/atom/electron dimensions differ')
    return mol


def optimize(args, state, output, case, settings, emit, log):
    import numpy as np
    from pyscf.geomopt import geometric_solver
    source, symbols, coords = prepared_geometry(args, case)
    state['preceding_result'] = artifact(args.source_result)
    mol = molecule(case, symbols, coords, settings, log)
    mf = make_scf(mol, settings, output / 'optimization.chk', args.threads, emit)
    gradient = mf.nuc_grad_method(); gradient.grid_response = settings['gradient_grid_response']
    (output / 'geometry_steps').mkdir()
    def callback(env):
        index = int(env['self'].cycle); stem = output / 'geometry_steps' / f'step_{index:04d}'
        xyz = env['mol'].atom_coords(unit='Angstrom'); grad = np.asarray(env['gradients'])
        require(bool(env['g_scanner'].converged) and np.isfinite(grad).all(), 'Optimization callback has unconverged SCF')
        geometry = {'atom_symbols': symbols, 'coordinates_angstrom': xyz.tolist(), 'energy_hartree': float(env['energy']),
                    'cycle': index, 'scf_converged': True, 'optimized_minimum_claim': False}
        save(stem.with_suffix('.json'), geometry, exclusive=True)
        stem.with_suffix('.xyz').write_text(xyz_text(symbols, xyz, 'Optimization checkpoint, not minimum certificate'))
        save_array(stem.with_suffix('.gradient.npy'), grad, np)
        state['last_geometry'] = artifact(stem.with_suffix('.json'))
        state['optimizer_last_cycle'] = index
        emit('geometry_cycle', cycle=index, energy_hartree=float(env['energy']))
    emit('optimization_started')
    state['quantum_payload_entered'] = True
    converged, mol = geometric_solver.kernel(gradient, maxsteps=args.maxsteps, assert_convergence=True,
                callback=callback, **settings['optimizer_thresholds'])
    state['optimizer_converged'] = bool(converged)
    require(converged, 'Optimizer did not converge within bounded maxsteps')
    xyz = mol.atom_coords(unit='Angstrom')
    geom = output / 'optimized_geometry.json'
    save(geom, {'atom_symbols': symbols, 'coordinates_angstrom': xyz.tolist(), 'optimizer_converged': True}, exclusive=True)
    (output / 'optimized.xyz').write_text(xyz_text(symbols, xyz, 'Local optimized geometry, inspect fresh gradient/frequencies'))
    state['optimized_geometry'] = artifact(geom)
    # A genuinely fresh final SCF/gradient; no optimizer-last-gradient shortcut.
    final = make_scf(mol, settings, output / 'fresh_final_scf.chk', args.threads, emit)
    state['energy_hartree'] = float(final.kernel()); state['scf_converged'] = bool(final.converged)
    require(final.converged and np.isfinite(final.e_tot), 'Fresh final SCF failed')
    gradient = np.asarray(gradient_of(final, settings, emit)); save_array(output / 'fresh_gradient.npy', gradient, np)
    state.update(gradient_checks(np, gradient, settings))
    require(state['fresh_gradient_thresholds_passed'], 'Fresh final gradient failed; no frequency eligibility')
    state.update(status='OPTIMIZATION_CONVERGED', geometry_optimized=True, stationary_minimum_verified=False,
                 frequency_validation_passed=False, frequencies_status='NOT_RUN', numerical_DFT_operations=1)
    emit('optimization_and_fresh_gradient_complete')


def frequency(args, state, output, case, settings, emit, log):
    import numpy as np
    from pyscf.hessian import thermo
    source, symbols, coords = optimized_geometry(args, case)
    state.update(preceding_result=artifact(args.source_result), optimizer_converged=True)
    mol = molecule(case, symbols, coords, settings, log)
    mf = make_scf(mol, settings, output / 'fresh_frequency_scf.chk', args.threads, emit)
    state['quantum_payload_entered'] = True
    state['energy_hartree'] = float(mf.kernel()); state['scf_converged'] = bool(mf.converged)
    require(mf.converged and np.isfinite(mf.e_tot), 'Fresh frequency SCF failed')
    grad = np.asarray(gradient_of(mf, settings, emit)); save_array(output / 'fresh_gradient.npy', grad, np)
    state.update(gradient_checks(np, grad, settings)); require(state['fresh_gradient_thresholds_passed'], 'Fresh frequency gradient failed')
    state['optimized_geometry'] = source['optimized_geometry']
    hessian = mf.Hessian(); hessian.max_cycle = settings['CPHF_max_cycle']; hessian.level_shift = 0
    hessian.max_memory = 2000
    require(getattr(mf, 'with_df', None) is None and mf.disp is None and mf._eri is None, 'Non-DF explicit noD3 direct required')
    emit('stock_complete_Hessian_started')
    raw = np.asarray(hessian.kernel(atmlst=list(range(case['atoms']))))
    require(raw.shape == (case['atoms'], case['atoms'], 3, 3) and np.isfinite(raw).all(), 'Incomplete full Hessian')
    save_array(output / 'hessian_raw.npy', raw, np)
    asymmetry = float(np.max(np.abs(raw - raw.transpose(1, 0, 3, 2))))
    state['raw_Hessian_max_asymmetry_Eh_per_Bohr2'] = asymmetry
    require(asymmetry <= 1e-5, 'Hessian asymmetry too large; do not hide with symmetrization')
    used = (raw + raw.transpose(1, 0, 3, 2)) * .5; save_array(output / 'hessian_used.npy', used, np)
    result = thermo.harmonic_analysis(mol, used, exclude_trans=True, exclude_rot=True, imaginary_freq=False)
    cm = np.asarray(result['freq_wavenumber']); modes = np.asarray(result['norm_mode'])
    require(not np.iscomplexobj(cm) and not np.iscomplexobj(modes) and cm.shape == (case['expected_normal_modes'],)
            and modes.shape == (case['expected_normal_modes'], case['atoms'], 3)
            and np.isfinite(cm).all() and np.isfinite(modes).all(), 'Complete finite signed real representation required')
    save_array(output / 'normal_modes.npy', modes, np)
    save_array(output / 'geometry_bohr.npy', mol.atom_coords(unit='Bohr'), np)
    save_array(output / 'frequencies_cm1.npy', cm, np)
    save_array(output / 'masses_amu.npy', mol.atom_mass_list(isotope_avg=True), np)
    with (output / 'frequencies.csv').open('x', newline='') as stream:
        writer = csv.writer(stream, lineterminator='\n'); writer.writerow(['mode', 'frequency_cm1', 'frequency_THz', 'imaginary', 'IR_intensity_status'])
        for index, value in enumerate(cm, 1):
            writer.writerow([index, float(value), float(value * CM1_TO_THZ), bool(value < 0), 'NOT_COMPUTED'])
    state.update(status='FREQUENCIES_COMPUTED', frequencies_status='DONE', normal_modes_complete=True,
                 **signed_mode_flags(cm, case['expected_normal_modes'], state['fresh_gradient_thresholds_passed']),
                 complete_global_Hessian=True,
                 frequencies_cm1=cm.tolist(), measured_CPHF_residual_norm='NOT_COMPUTED',
                 stock_CPHF_normal_return_not_independent_residual_verification=True, numerical_DFT_operations=1)
    state['arrays'] = {p.name: artifact(p) for p in output.glob('*.npy')}
    emit('signed_modes_complete', normal_mode_count=len(cm), imaginary_frequency_count=int(np.sum(cm < 0)))


def analyze(args, state, output, case, settings, emit):
    import numpy as np
    source = source_result(args, 'frequency', ('FREQUENCIES_COMPUTED',))
    require(source.get('normal_mode_count') == case['expected_normal_modes'], 'All signed modes required')
    def array(name, shape):
        value = np.load(checked_record(source['arrays'][name]), allow_pickle=False)
        require(value.shape == shape and np.isfinite(value).all(), 'Analysis array shape/finiteness differs: ' + name)
        return value
    n = case['atoms']; k = case['expected_normal_modes']
    raw = array('hessian_raw.npy', (n, n, 3, 3)); used = array('hessian_used.npy', (n, n, 3, 3))
    xyz = array('geometry_bohr.npy', (n, 3)); cm = array('frequencies_cm1.npy', (k,))
    mass = array('masses_amu.npy', (n,)); modes = array('normal_modes.npy', (k, n, 3))
    require(np.max(np.abs(used - (raw + raw.transpose(1, 0, 3, 2)) * .5)) < 1e-14, 'Hessian symmetrization differs')
    geometry = read_json(checked_record(source['optimized_geometry'])); symbols = geometry['atom_symbols']
    validate_coordinates(symbols, geometry['coordinates_angstrom'], case)
    geometry_delta = float(np.max(np.abs(xyz * BOHR_TO_ANGSTROM - np.asarray(geometry['coordinates_angstrom']))))
    require(geometry_delta <= 1e-10, 'Mode geometry and exact optimized atom-order coordinates differ')
    require(np.allclose(mass, [MASSES[s] for s in symbols], atol=1e-12, rtol=0), 'Mass convention differs')
    center = np.einsum('i,ij->j', mass, xyz) / np.sum(mass); centered = xyz - center
    ext = []
    for axis in np.eye(3):
        ext.append((np.sqrt(mass)[:, None] * np.broadcast_to(axis, (n, 3))).ravel())
        ext.append((np.sqrt(mass)[:, None] * np.cross(centered, axis)).ravel())
    u, singular, _ = np.linalg.svd(np.asarray(ext).T, full_matrices=True)
    require(int(np.sum(singular > 1e-10)) == 6, 'Expected nonlinear six-dimensional external space')
    vib = u[:, 6:]; weights = np.repeat(np.sqrt(mass), 3)
    cart = used.transpose(0, 2, 1, 3).reshape(3 * n, 3 * n)
    weighted = cart / weights[:, None] / weights[None, :]
    reduced = vib.T @ weighted @ vib
    eig, vec = np.linalg.eigh((reduced + reduced.T) * .5)
    replay = np.sign(eig) * np.sqrt(np.abs(eig)) * FREQUENCY_FACTOR_CM1
    error = float(np.max(np.abs(replay - cm)))
    mw_modes = modes.reshape(k, 3 * n) * weights[None, :]
    orthogonality = float(np.max(np.abs(mw_modes @ mw_modes.T - np.eye(k))))
    external_error = float(np.max(np.abs(mw_modes @ u[:, :6])))
    eig_residual = float(np.max(np.abs(reduced @ vec - vec * eig[None, :])))
    saved_coords = vib.T @ mw_modes.T
    saved_eigenvalues = np.sign(cm) * (np.abs(cm) / FREQUENCY_FACTOR_CM1) ** 2
    saved_residual = float(np.max(np.abs(reduced @ saved_coords - saved_coords * saved_eigenvalues[None, :])))
    passed = (error <= 1e-6 and orthogonality <= 1e-6 and external_error <= 1e-6
              and eig_residual <= 1e-9 and saved_residual <= 1e-8)
    require(passed, 'Independent NumPy signed-frequency/TR replay failed')
    with (output / 'independent_frequencies.csv').open('x', newline='') as stream:
        writer = csv.writer(stream, lineterminator='\n'); writer.writerow(['mode', 'frequency_cm1', 'frequency_THz', 'imaginary', 'IR_intensity_status'])
        for index, value in enumerate(replay, 1):
            writer.writerow([index, float(value), float(value * CM1_TO_THZ), bool(value < 0), 'NOT_COMPUTED'])
    state.update(status='MODES_ANALYZED', preceding_result=artifact(args.source_result),
                 **signed_mode_flags(replay, k, source['fresh_gradient_thresholds_passed']),
                 optimizer_converged=source['optimizer_converged'], scf_converged=source['scf_converged'],
                 fresh_gradient_thresholds_passed=source['fresh_gradient_thresholds_passed'],
                 final_gradient_thresholds_passed=source['final_gradient_thresholds_passed'],
                 independent_mode_replay_passed=True, independent_replay_new_quantum_evaluations=0,
                 max_frequency_difference_cm1=error, mass_weighted_orthogonality_error=orthogonality,
                 external_projection_error=external_error, projected_eigen_equation_residual=eig_residual,
                 saved_mode_eigen_equation_residual=saved_residual,
                 mode_geometry_max_difference_angstrom=geometry_delta,
                 projected_eigen_residual_units='Eh/(amu Bohr^2)', residual_is_not_a_CPHF_residual=True,
                 signed_frequencies_cm1=replay.tolist(), numerical_DFT_operations=0)
    emit('independent_numpy_replay_complete', imaginary_frequency_count=int(np.sum(replay < 0)))


def run(args):
    manifest, case = input_case(args.case)
    require(1 <= args.conformers <= 16, 'Bounded1..16 ETKDG candidates required')
    if not args.execute:
        return {'schema': SCHEMA, 'status': 'NOT_RUN', 'case': args.case, 'operation': args.operation,
                'input_manifest_sha256': INPUT_SHA, 'source_worker': artifact(__file__),
                'expected_modes_not_actual_frequencies': case['expected_normal_modes'], 'new_quantum_evaluations': 0,
                'IR_intensities_status': 'NOT_COMPUTED', 'default_preflight_only': True}
    supervision = supervise(args)  # FIRST: no RDKit/NumPy/PySCF imports before realB-parent verification.
    output = new_output(args.output); start = time.perf_counter(); cpu = time.process_time()
    state = {'schema': SCHEMA, 'status': 'PARTIAL', 'case': args.case, 'operation': args.operation,
             'source_worker': artifact(__file__), 'input_manifest_sha256': INPUT_SHA,
             'resource_supervision': supervision, 'output_directory': str(output), 'started_at_utc': utc(),
             'chemical_identity': case, 'settings': manifest['method'], 'atoms': case['atoms'],
             'electrons': case['electrons'], 'basis_functions': case['basis_functions'],
             'IR_intensities_status': 'NOT_COMPUTED', 'chemical_peak_assignment_verified': False,
             'theory_enters_classifier': False, 'independent_plant_samples_added': 0,
             'is_software_control': case['is_software_control'], 'numerical_DFT_operations': 0,
             'A_state_ledger_data_or_models_modified': False, 'global_minimum_search_performed': False}
    state.update(quantum_payload_entered=False, optimizer_maxsteps_actual=args.maxsteps,
                 new_quantum_evaluations_scope='BOOLEAN_QUANTUM_STAGE_ENTERED_NOT_SCF_CYCLE_COUNT')
    save(output / 'input.json', state, exclusive=True)
    def emit(event, **data):
        row = {'utc': utc(), 'event': event, 'wall_seconds': time.perf_counter() - start,
               'process_cpu_seconds': time.process_time() - cpu, **data}
        with (output / 'events.jsonl').open('a') as stream:
            stream.write(json.dumps(row, allow_nan=False) + '\n'); stream.flush()
        save(output / 'progress.json', {**state, **row})
    def stopped(signum, _frame):
        raise RuntimeError('ActualBsupervisor resource/termination signal ' + str(signum))
    handlers = {sig: signal.signal(sig, stopped) for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGXCPU)}
    log = (output / 'pyscf.log').open('x', buffering=1)
    try:
        state['versions'] = versions()
        if args.operation == 'prepare':
            prepare(args, state, output, case, emit)
        elif args.operation == 'optimize':
            optimize(args, state, output, case, manifest['method'], emit, log)
        elif args.operation == 'frequency':
            frequency(args, state, output, case, manifest['method'], emit, log)
        else:
            analyze(args, state, output, case, manifest['method'], emit)
    except BaseException as error:
        state.update(status='PARTIAL', exception_type=type(error).__name__, stop_reason=str(error))
        (output / 'exception_traceback.txt').write_text(traceback.format_exc())
    finally:
        for sig, old in handlers.items():
            signal.signal(sig, old)
        state.update(completed_at_utc=utc(), wall_seconds=time.perf_counter() - start,
                     process_cpu_seconds=time.process_time() - cpu,
                     peak_rss_kib=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
        state['checkpoint_files'] = [artifact(p) for p in output.glob('*.chk')]
        # Actual count describes operations entered, not SCF cycle or force-field counts.
        state['new_quantum_evaluations'] = int(state['quantum_payload_entered'])
        log.flush(); log.close(); save(output / 'result.json', state, exclusive=True)
    return state


def parser():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--case', choices=CASE_NAMES, required=True)
    p.add_argument('--operation', choices=OPERATIONS, required=True)
    p.add_argument('--output', type=Path, required=True)
    p.add_argument('--execute', action='store_true')
    p.add_argument('--source-result', type=Path); p.add_argument('--source-result-sha256')
    p.add_argument('--threads', type=int, choices=(1, 2), default=2)
    p.add_argument('--maxsteps', type=int, default=25)
    p.add_argument('--conformers', type=int, default=8); p.add_argument('--seed', type=int, default=20261106)
    return p


def main():
    args = parser().parse_args(); result = run(args)
    print(json.dumps({k: result.get(k) for k in ('status', 'case', 'operation', 'normal_mode_count',
          'imaginary_frequency_count', 'stationary_minimum_verified', 'stop_reason')}, ensure_ascii=False), flush=True)
    if args.execute and result['status'] == 'PARTIAL':
        raise SystemExit(2)


if __name__ == '__main__':
    main()
