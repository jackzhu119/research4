  "findings": [
    {
      "id": "acid_selected_negative_modes_not_confirmed",
      "statement": "At the two selected original imaginary-mode directions (1 and 4), independent central energy and gradient differences are positive for both 0.005 and 0.01 Bohr. These observations do not support interpreting those two saved negative analytic curvatures as actual local negative energy curvatures.",
      "analytic_negative_modes": [
        1,
        4
      ],
      "scope": "Original exact geometry; PBE/def2-SVP/grid1; numerical SCF tolerance tightened to 1e-10; no claim about all vibrational directions."
    },
    {
      "id": "acid_positive_control_magnitude_inconsistent",
      "statement": "Original positive mode 5 remains positive but its actual finite-difference curvature is substantially larger than the saved analytic prediction; the discrepancy is not confined to classifying near-zero signs."
    },
    {
      "id": "water_translation_inconsistency_confirmed",
      "statement": "The saved analytic water Hessian predicts negative uniform-translation curvature −0.0221329 Eh/Bohr^2, while independent paired energies and gradients remain translation invariant to numerical noise at both step sizes. Projecting six external directions away can mask this consistency failure."
    },
    {
      "id": "one_sided_lower_energy_is_not_negative_curvature",
      "statement": "Acid modes 1 and 5 can have a displaced energy below the center despite positive symmetric curvature because the reference geometry has a small nonzero first derivative. Use paired central curvature, not one-sided energy changes, to distinguish curvature from residual slope."
    }
  ],
  "limitations": [
    "Original Hessian SCF energy tolerance is 1e-8; point calculations use 1e-10. This is explicitly a numerical sensitivity comparison, not identical recorded settings.",
    "Each displaced geometry rebuilds the atom-centered grid; baseline gradients use grid_response=False, so finite quadrature response differences remain a possible explanation.",
    "These data identify a reproducible derivative inconsistency but do not isolate its implementation or numerical cause. Grid/response variants are still pending.",
    "Only selected acid modes 1,4,5 and water mode1/translation-axis0 have been tested here. This does not establish full Hessian positivity or a stable minimum.",
    "No finite-difference completion claim is made here for calycosin; its matching diagnostic stages are still running."
  ],
