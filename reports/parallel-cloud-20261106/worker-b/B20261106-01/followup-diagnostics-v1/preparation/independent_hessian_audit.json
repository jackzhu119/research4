{
  "schema": "research4-independent-hessian-postprocessing-audit-v1",
  "created_at_utc": "2026-11-06T15:25:39.258241+00:00",
  "new_quantum_evaluations": 0,
  "original_source_or_results_modified": false,
  "scope": "Recompute rigid-body consistency and saved negative-mode characters from sealed complete Hessians; not an independent quantum derivative test.",
  "formulas": {
    "cartesian_matrix": "H = hessian_raw.transpose(0,2,1,3).reshape(3*N,3*N)",
    "translation_vectors": "T[:,axis] = tile(unit_axis,N)/sqrt(N); each column has Euclidean norm 1",
    "translation_residual": "max(abs(H @ T)); units Eh/Bohr^2; exact translationally invariant potential requires zero",
    "mass_weighted_matrix": "Hw = H / sqrt(repeat(masses,3))[:,None] / sqrt(repeat(masses,3))[None,:]",
    "external_basis": "SVD orthonormalization of mass-weighted uniform translations and infinitesimal rotations about mass center; six columns",
    "external_block": "eigvalsh(Qexternal.T @ Hw @ Qexternal)",
    "external_vibration_coupling": "max(abs(Qvib.T @ Hw @ Qexternal))",
    "mode_unit_cartesian_direction": "q = normal_mode.flatten() / norm(normal_mode.flatten())",
    "mode_cartesian_curvature": "q.T @ H @ q; units Eh/Bohr^2; q normalization differs from mass-weighted eigenvalue",
    "hydrogen_mode_fraction": "sum(displacement^2 over H atoms)/sum(displacement^2 over all atoms)"
  },
