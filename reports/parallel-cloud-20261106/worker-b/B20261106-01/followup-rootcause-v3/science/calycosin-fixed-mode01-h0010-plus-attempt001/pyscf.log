def require(condition, message):
    if not condition:
        raise ValueError(message)


def utc():
    return datetime.now(timezone.utc).isoformat()


def sha(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as handle:
        for block in iter(lambda: handle.read(1024 ** 2), b""):
            digest.update(block)
    return digest.hexdigest()


def local_path(value):
    original = Path(value)
    original = original if original.is_absolute() else ROOT / original
    resolved = original.resolve()
    require(resolved.is_relative_to(ROOT), "Source/output must remain in this checkout")
    require(not any(p.is_symlink() for p in (original, *original.parents) if p != ROOT.parent),
            "Symlink source/output is not accepted")
    return resolved


def ref(path):
    p = local_path(path)
    return {"path": p.relative_to(ROOT).as_posix(), "sha256": sha(p), "bytes": p.stat().st_size}


def checked(record, max_bytes=32 * 1024 ** 2):
    require(isinstance(record, dict) and isinstance(record.get("path"), str)
            and isinstance(record.get("sha256"), str) and len(record["sha256"]) == 64,
            "Explicit path/SHA256 source binding is required")
    p = local_path(record["path"])
    require(p.is_file() and p.stat().st_size <= max_bytes, "Missing or oversized bounded source")
    require(sha(p) == record["sha256"], "Source hash changed: " + str(p))
    if "bytes" in record:
        require(p.stat().st_size == record["bytes"], "Source size changed")
    return p


def read(path):
    p = local_path(path)
    require(p.is_file() and p.stat().st_size <= 4 * 1024 ** 2, "Small existing JSON required")
    return json.loads(p.read_text())


def save(path, value, exclusive=False):
    p = local_path(path)
    temporary = p if exclusive else p.with_name(p.name + ".writing-" + str(os.getpid()))
    with temporary.open("x") as handle:
        json.dump(value, handle, ensure_ascii=False, indent=2, allow_nan=False)
        handle.write("\n"); handle.flush(); os.fsync(handle.fileno())
    if not exclusive:
        os.replace(temporary, p)


def save_array(path, array, np):
    require(np.isfinite(array).all(), "Finite array required")
    with Path(path).open("xb") as handle:
        np.save(handle, array, allow_pickle=False)


def load_module(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    require(spec is not None and spec.loader is not None, "Required source module unavailable")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def validate_request(request):
    require(request.get("schema") == REQUEST_SCHEMA, "Wrong diagnostic request schema")
    require(request.get("operation") in ("point", "postprocess", "aggregate", "fixed_grid_center", "fixed_grid_point", "response_audit"), "Unsupported operation")
    require(request.get("threads", 2) == 2, "Released diagnostic allocation uses two numerical threads")
    if request["operation"] in ("point", "fixed_grid_center", "fixed_grid_point", "response_audit"):
        request = dict(request)
        if request["operation"] in ("fixed_grid_center", "response_audit"):
            request.setdefault("direction", {"type": "translation", "axis": 0})
            request.setdefault("step_bohr", 0)
            request.setdefault("sign", 0)
        require(request.get("case") in CASES, "Registered Worker B case required")
        direction = request.get("direction", {})
        require(direction.get("type") in ("mode", "translation"), "Mode or translation direction required")
        if direction["type"] == "mode":
            require(type(direction.get("index")) is int and direction["index"] >= 1,
                    "Mode index is positive and one based")
        else:
            require(type(direction.get("axis")) is int and direction["axis"] in (0, 1, 2),
                    "Translation axis must be 0, 1, or 2")
        h, sign = request.get("step_bohr"), request.get("sign")
        require(type(h) in (int, float) and math.isfinite(h), "Finite displacement required")
        require(type(sign) is int and sign in (-1, 0, 1), "Signed displacement must be -1, 0, or 1")
        require((h == 0 and sign == 0) or (1e-4 <= h <= .02 and sign in (-1, 1)),
                "Use center h=0/sign=0 or 0.0001..0.02 Bohr with sign +/-1")
        if request["operation"] == "fixed_grid_center":
            require(h == 0 and sign == 0, "Fixed-grid center must have h=0/sign=0")
        if request["operation"] == "fixed_grid_point":
            require(h > 0 and sign in (-1, 1), "Fixed-grid point requires a nonzero signed displacement")
        require(request.get("grid_level", 1) in (1, 3), "Only explicit grid levels 1 and 3 are released")
        require(type(request.get("gradient_grid_response", False)) is bool, "Grid response must be boolean")
        require(request.get("grid_prune", "default") in ("default", "none"), "Unknown quadrature pruning")
        tolerance = request.get("scf_conv_tol", 1e-8)
        require(type(tolerance) in (int, float) and math.isfinite(tolerance) and 1e-12 <= tolerance <= 1e-8,
                "SCF energy tolerance must be 1e-12..1e-8 Hartree")
        if request["operation"] != "point":
            require(request.get("gradient_grid_response", False) is False,
                    "Fixed Cartesian quadrature diagnostics require gradient_grid_response=False")
        if request["operation"] == "response_audit":
            require(1e-13 <= request.get("cphf_tol", 1e-10) <= 1e-8, "Bounded explicit CPHF tolerance required")
            require(type(request.get("cphf_max_cycle", 100)) is int and 1 <= request.get("cphf_max_cycle", 100) <= 200,
                    "Bounded explicit CPHF iteration cap required")
            require(type(request.get("include_fock_fd", True)) is bool
                    and type(request.get("include_stock_direct_control", False)) is bool,
                    "Response control switches must be boolean")


